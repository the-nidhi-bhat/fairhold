# FairHold environment template.
# Copy to .env and fill in local values. Never commit the real .env file.
# All values below are placeholders only — no real credentials.

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
# Leave DATABASE_URL unset to run in development mode with the JSON dev store
# (.data/fairhold.json) — no database required.
# Set it to a real PostgreSQL connection string to use the PostgreSQL backend:
#   - npm run db:migrate   applies pending migrations (idempotent, transactional)
#   - npm run db:import    imports the JSON dev store into PostgreSQL
#                          (idempotent; never modifies or deletes the JSON file)
# There is NO silent fallback: if PostgreSQL is configured but unreachable, the
# app fails loudly instead of quietly using the JSON store.
DATABASE_URL=postgresql://user:password@localhost:5432/fairhold

# --- PayPal (server-side only; never expose these to the browser) ---
# Leave PAYPAL_ENV unset (or set it to anything except "sandbox") to run with
# the simulated demo provider — no network, no credentials needed.
# To enable the real sandbox adapter: PAYPAL_ENV=sandbox AND real sandbox
# credentials from developer.paypal.com (not "your_..." placeholders; the app
# ignores placeholder values and silently stays on the demo provider).
# This is a 29-day authorization hold — an authorization is NEVER captured,
# settled, or refunded by FairHold in the current build. No production/live
# credentials are ever accepted here.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# --- AI provider (server-side only) ---
AI_API_KEY=your_ai_api_key
AI_MODEL=your_model_name

# --- Auth / signing ---
AUTH_SECRET=generate_a_long_random_secret
PAYMENT_CONDITIONS_SIGNING_SECRET=generate_a_long_random_secret
