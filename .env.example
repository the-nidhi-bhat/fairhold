# FairHold environment template.
# Copy to .env and fill in local values. Never commit the real .env file.
# All values below are placeholders only — no real credentials.

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/fairhold

# --- PayPal (server-side only; never expose these to the browser) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# --- AI provider (server-side only) ---
AI_API_KEY=your_ai_api_key
AI_MODEL=your_model_name

# --- Auth / signing ---
AUTH_SECRET=generate_a_long_random_secret
PAYMENT_CONDITIONS_SIGNING_SECRET=generate_a_long_random_secret
