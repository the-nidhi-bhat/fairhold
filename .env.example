# FairHold environment template.
# Copy to .env and fill in local values. Never commit the real .env file.
# All values below are placeholders only — no real credentials.

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
# Leave DATABASE_URL unset to run in development mode with the JSON dev store
# (.data/fairhold.json) — no database required.
# Set it to a real PostgreSQL connection string to use the PostgreSQL backend:
#   - npm run db:migrate   applies pending migrations (idempotent, transactional)
#   - npm run db:import    imports the JSON dev store into PostgreSQL
#                          (idempotent; never modifies or deletes the JSON file)
# There is NO silent fallback: if PostgreSQL is configured but unreachable, the
# app fails loudly instead of quietly using the JSON store.
DATABASE_URL=postgresql://user:password@localhost:5432/fairhold

# --- PayPal (server-side only; never expose these to the browser) ---
# Leave PAYPAL_ENV unset (or set it to anything except "sandbox") to run with
# the simulated demo provider — no network, no credentials needed.
# To enable the real sandbox adapter: PAYPAL_ENV=sandbox AND real sandbox
# credentials from developer.paypal.com (not "your_..." placeholders; the app
# ignores placeholder values and silently stays on the demo provider).
# This is a 29-day authorization hold. FairHold captures and voids an
# authorization only after a recorded human approval; it does not implement
# refunds, settlement or marketplace payouts. No production/live credentials
# are ever accepted here.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# Webhook signature verification: register this app's public HTTPS listener URL
# under the app on developer.paypal.com (App settings -> Webhooks) and paste the
# Webhook ID shown there. Required for the /api/paypal/webhook endpoint; without
# it the endpoint responds 503. PostgreSQL (DATABASE_URL) is also required for
# webhook processing — the JSON dev store has no webhook inbox.
# Never commit the real Webhook ID.
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# --- AI provider (server-side only) ---
# FairHold uses the Google Gemini API for live advisory calls. The code reads
# GEMINI_API_KEY and GEMINI_MODEL; both are required for live provider calls.
# When either is missing or looks like a placeholder, the deterministic fallback
# runs so the core workflow is never blocked.
# Set GEMINI_API_URL only if you need a non-default Gemini endpoint.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent

# --- Auth / signing ---
AUTH_SECRET=generate_a_long_random_secret
FAIRHOLD_SESSION_SECRET=generate_a_long_random_session_secret
# Comma-separated names explicitly allowed to use hackathon demo identities.
# Reviewer entries are privileged and should be unique, named accounts only.
# The guided demo uses: Alex Buyer (buyer), Jamie Seller (seller),
# Morgan Reviewer (reviewer). Replace with your own demo identities if needed.
# Empty allowlists reject every sign-in — the demo is closed by default
# until these are set on your deployment (locally: .env; preview: Vercel env).
FAIRHOLD_DEMO_BUYERS=alex buyer
FAIRHOLD_DEMO_SELLERS=jamie seller
FAIRHOLD_DEMO_REVIEWERS=morgan reviewer
# Deal-specific reviewer grants: reviewer-name:deal-id (comma-separated).
# Morgan Reviewer is granted access to the demo deal by name. Replace the
# deal ID with an actual deal from the demo fixture.
FAIRHOLD_REVIEWER_DEALS=morgan reviewer:demo-deal-1
PAYMENT_CONDITIONS_SIGNING_SECRET=generate_a_long_random_secret
