{
  "name": "fairhold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"lib/**/*.test.ts\"",
    "test:e2e": "node scripts/run-e2e.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/db-migrate.mjs",
    "db:import": "node --env-file-if-exists=.env scripts/db-import-json.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "lighthouse": "^13.6.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
